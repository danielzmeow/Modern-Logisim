{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Logisim Studio",
  "version": "0.1.0",
  "identifier": "com.danielwang.logisimstudio",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "DeveloperTool",
    "copyright": "© 2026 Daniel Wang",
    "shortDescription": "A fast, modern digital circuit editor",
    "longDescription": "Logisim Studio is a local-first digital circuit editor for macOS: draw, wire and simulate logic circuits, build truth tables and generate gates from equations.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
